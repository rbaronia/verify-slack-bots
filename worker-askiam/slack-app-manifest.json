{
  "display_information": {
    "name": "AskIAM",
    "description": "Natural-language IBM Verify IAM queries for Slack",
    "background_color": "#0f62fe"
  },
  "features": {
    "bot_user": {
      "display_name": "AskIAM",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/askiam",
        "url": "https://askiam-bot.baronia.workers.dev/slack/command",
        "description": "Query IBM Verify IAM - users, groups, MFA, access requests",
        "usage_hint": "how many users | show my access requests | list groups",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://askiam-bot.baronia.workers.dev/slack/action"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
